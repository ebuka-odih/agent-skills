+    public function cancel(Request $request, Booking $booking)
+    {
+        dd($booking->toArray());
+
+        $minutesLeft = now()->diffInMinutes($booking->class->starts_at, false);
+
+        if ($minutesLeft < 60) {
+            return response()->json(['message' => 'Too late to cancel'], 422);
+        }
+
+        $booking->update(['status' => 'cancelled']);
+
+        $this->payments->refund($booking->payment_id, $booking->amount_cents / 2);
+
+        return new BookingResource($booking);
+    }
+
